#!/bin/bash

# Slackware build script for wscreensavers
# Maintained by Christopher Patrick Fair <christopherpatrickfair@gmail.com>

cd $(dirname $0) ; CWD=$(pwd)

PRGNAM=wscreensavers
VERSION=${VERSION:-1.0.29}
BUILD=${BUILD:-1}
TAG=${TAG:-_cf}
PKGTYPE=${PKGTYPE:-txz}

if [ -z "$ARCH" ]; then
  case "$( uname -m )" in
    i?86) ARCH=i586 ;;
    arm*) ARCH=arm ;;
       *) ARCH=$( uname -m ) ;;
  esac
fi

TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

if [ "$ARCH" = "i586" ]; then
  SLKCFLAGS="-O2 -march=i586 -mtune=i686"
  LIBDIRSUFFIX=""
elif [ "$ARCH" = "i686" ]; then
  SLKCFLAGS="-O2 -march=i686 -mtune=i686"
  LIBDIRSUFFIX=""
elif [ "$ARCH" = "x86_64" ]; then
  SLKCFLAGS="-O2 -fPIC"
  LIBDIRSUFFIX="64"
else
  SLKCFLAGS="-O2"
  LIBDIRSUFFIX=""
fi

set -e

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT
cd $TMP
rm -rf $PRGNAM-$VERSION

if [ -f "$CWD/$PRGNAM-$VERSION.tar.gz" ]; then
  tar xvf "$CWD/$PRGNAM-$VERSION.tar.gz"
elif [ -f "$CWD/../../go.mod" ]; then
  mkdir -p "$PRGNAM-$VERSION"
  cp -a "$CWD/../../"* "$PRGNAM-$VERSION/" 2>/dev/null || true
else
  echo "==> Fetching upstream archive for v$VERSION..."
  curl -sL "https://github.com/chrisfair/$PRGNAM/archive/refs/tags/v$VERSION.tar.gz" -o "$TMP/$PRGNAM-$VERSION.tar.gz"
  tar xvf "$TMP/$PRGNAM-$VERSION.tar.gz"
fi

cd "$TMP/$PRGNAM-$VERSION"
chown -R root:root . 2>/dev/null || true
find -L . \
 \( -perm 777 -o -perm 726 -o -perm 711 -o -perm 555 -o -perm 511 \) -exec chmod 755 {} \+ -o \
 \( -perm 666 -o -perm 664 -o -perm 640 -o -perm 600 -o -perm 444 \
  -o -perm 440 -o -perm 400 \) -exec chmod 644 {} \+

export CFLAGS="$SLKCFLAGS"
export CXXFLAGS="$SLKCFLAGS"

# Build frontend and binary
make build

# Install into staging area
make install DESTDIR="$PKG" PREFIX=/usr

# Strip binaries
find "$PKG" -print0 2>/dev/null | xargs -0 file 2>/dev/null | grep -e "executable" -e "shared object" | grep ELF \
  | cut -f 1 -d : | xargs --no-run-if-empty strip --strip-unneeded 2> /dev/null || true

# Documentation
mkdir -p "$PKG/usr/doc/$PRGNAM-$VERSION"
cp -a LICENSE README.md "$PKG/usr/doc/$PRGNAM-$VERSION/"

# Slackware package description
mkdir -p "$PKG/install"
cat "$CWD/slack-desc" > "$PKG/install/slack-desc"

cd "$PKG"
if [ -f /etc/slackware-version ] && [ -x /sbin/makepkg ]; then
  /sbin/makepkg -l y -c n "$OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
else
  echo "==> Packaging $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.txz..."
  tar -cJf "$OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.txz" .
fi

echo "==> Slackware package created at: $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
